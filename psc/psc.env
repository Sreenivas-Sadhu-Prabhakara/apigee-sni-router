# ── PSC / internal-NEG-LB layer configuration ────────────────────────────────
# Chain: Apigee X --southbound PSC--> service attachment --> REGIONAL internal
#        Application LB --> 3 regional Internet NEGs --> httpbin/postman/mocktarget
export PSC_PROJECT="apigee-neg-psc"
export PSC_REGION="asia-south1"                 # same region as the Apigee runtime
export PSC_NETWORK="sni-psc-net"                # dedicated custom VPC (isolated, clean teardown)
export LB_SUBNET="sni-lb-subnet"               # regular subnet for the internal LB VIP
export LB_SUBNET_RANGE="10.50.0.0/24"
export PROXY_SUBNET="sni-proxy-only"           # REGIONAL_MANAGED_PROXY (the LB's Envoys)
export PROXY_SUBNET_RANGE="10.50.1.0/24"
export PSC_NAT_SUBNET="sni-psc-nat"            # PRIVATE_SERVICE_CONNECT NAT subnet
export PSC_NAT_RANGE="10.50.2.0/28"
export SA_NAME="sni-southbound-sa"             # PSC service attachment (producer)
export FR_NAME="sni-psc-fr"                    # internal LB forwarding rule
export URLMAP="sni-psc-urlmap"
export THP="sni-psc-http-proxy"
export ROUTER="sni-psc-router"
export NAT="sni-psc-nat-gw"

# Apigee side
export APIGEE_ORG="apigee-neg-psc"
export APIGEE_ENV="eval"
export EA_NAME="sni-southbound-ea"             # Apigee endpoint attachment (consumer, 1:1 with SA)
export TARGETSERVER="sb-psc-target"            # Apigee TargetServer -> the EA's PUPI IP

# Backends: "key|fqdn|path"  (path = the exact origin endpoint each domain echoes at)
export BACKENDS="httpbin|httpbin.org|/anything postman|postman-echo.com|/get mocktgt|mocktarget.apigee.net|/json"
