<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Backend C. Outbound TLS SNI -> mocktarget.apigee.net. Pinned to /json. -->
<TargetEndpoint name="mocktarget-target">
  <PreFlow name="PreFlow"><Request><Step><Name>AM-PSC-mocktgt</Name></Step></Request><Response/></PreFlow>
  <PostFlow name="PostFlow"><Request/><Response/></PostFlow>
  <Flows/>
  <FaultRules>
    <FaultRule name="backend-error">
      <Step><Name>AM-Fault-BackendError</Name></Step>
    </FaultRule>
  </FaultRules>
  <DefaultFaultRule name="backend-default-fault">
    <Step><Name>AM-Fault-BackendError</Name></Step>
  </DefaultFaultRule>
  <!-- Now routes via PSC to the internal LB; the LB re-originates HTTPS to mocktarget.apigee.net. -->
  <HTTPTargetConnection>
    <LoadBalancer>
      <Server name="sb-psc-target"/>
    </LoadBalancer>
    <Properties>
      <Property name="success.codes">1xx,2xx,3xx,4xx,5xx</Property>
    </Properties>
  </HTTPTargetConnection>
</TargetEndpoint>
