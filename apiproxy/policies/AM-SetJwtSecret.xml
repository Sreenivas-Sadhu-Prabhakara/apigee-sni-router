<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Loads the HS256 shared secret into a private.* variable (masked in traces).
     Apigee requires the HS256 key to be >= 32 bytes. In production this belongs in
     an encrypted KVM, not inline - see docs/DESIGN.md. -->
<AssignMessage continueOnError="false" enabled="true" name="AM-SetJwtSecret">
  <DisplayName>AM-SetJwtSecret</DisplayName>
  <AssignVariable>
    <Name>private.secretkey</Name>
    <Value>sni-router-demo-hs256-secret-please-rotate</Value>
  </AssignVariable>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
