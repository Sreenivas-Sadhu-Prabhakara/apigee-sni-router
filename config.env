# ── apigee-sni-router :: deployment configuration ────────────────────────────
# Source this before running any script:  set -a; source ./config.env; set +a

# ── Target org / environment (discovered from your account) ──────────────────
export ORG="apigee-neg-psc"
export ENVIRONMENT="eval"
export ENV_GROUP="eval-group"                        # env group that owns the runtime hostname(s)
export RUNTIME_HOST="8-232-203-178.nip.io"          # env-group hostname (nip.io wildcard -> 8.232.203.178)
export BASE_URL="https://${RUNTIME_HOST}"

# ── Proxy identity ───────────────────────────────────────────────────────────
export PROXY_NAME="sni-router-v1"
export BASE_PATH="/sni-router"

# ── Three backends on three genuinely different domains ──────────────────────
#   routing key   path    host-header (virtual host)        backend (outbound TLS SNI)
#   A             /a      api-a.${RUNTIME_HOST}             https://httpbin.org
#   B             /b      api-b.${RUNTIME_HOST}             https://postman-echo.com
#   C             /c      api-c.${RUNTIME_HOST}             https://mocktarget.apigee.net
export BACKEND_A="https://httpbin.org"
export BACKEND_B="https://postman-echo.com"
export BACKEND_C="https://mocktarget.apigee.net"

# ── Authorization model (Products gate WHICH backend an app may reach) ───────
export DEVELOPER_EMAIL="sni-dev@example.com"
export DEVELOPER_FIRST="Sni"
export DEVELOPER_LAST="Dev"

# Products: each maps to allowed proxy PATH(s) + OAuth scope(s) + a custom attribute
# "backends" (a|b|c list) that the proxy checks against flow.backend for API-key authz.
export PRODUCT_A="sni-product-a"     # path /a ; scope read:a ; backends=a
export PRODUCT_B="sni-product-b"     # path /b ; scope read:b ; backends=b
export PRODUCT_C="sni-product-c"     # path /c ; scope read:c ; backends=c
export PRODUCT_ALL="sni-product-all" # all paths ; scopes read:a read:b read:c ; backends=a,b,c

# Apps (each app's key/secret is filled in by scripts/20-create-authz.sh -> .secrets.env)
export APP_A="sni-app-a"             # subscribed to PRODUCT_A  -> can reach only backend A
export APP_B="sni-app-b"             # subscribed to PRODUCT_B  -> can reach only backend B
export APP_ALL="sni-app-all"         # subscribed to PRODUCT_ALL-> can reach all three

# OAuth2 scopes
export SCOPE_A="read:a"
export SCOPE_B="read:b"
export SCOPE_C="read:c"

# JWT (self-contained HS256 demo — no external IdP).
# NOTE: the actual secret/issuer/audience live in the policy XML
# (apiproxy/policies/AM-SetJwtSecret.xml, GenerateJWT-HS256.xml, VerifyJWT-HS256.xml).
# In production, move the secret to an encrypted KVM and reference it from AM-SetJwtSecret.
export JWT_ISSUER="urn://sni-router"        # documentation only; must match the policy
export JWT_AUDIENCE="sni-router-clients"    # documentation only; must match the policy
